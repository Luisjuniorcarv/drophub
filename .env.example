# ==========================================
# DROPHUB - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==========================================

# 1. Banco de Dados PostgreSQL
DATABASE_URL="postgresql://drophub_user:drophub_secure_pass@localhost:5432/drophub_db?schema=public"

# 2. Segurança & JWT (Sessão Administrativa via Cookies HTTP-Only)
JWT_SECRET="drophub_super_secret_jwt_key_at_least_32_characters_long_2026"
ENCRYPTION_KEY="drophub_super_secret_encryption_key_32_bytes_long_2026" # Chave AES-256-GCM para credenciais de fornecedores
COOKIE_NAME="drophub_admin_session"
NODE_ENV="development" # Em produção mudar para "production" para ativar Secure Cookies

# 3. URL Base da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Webhooks & Segurança de Integração
WEBHOOK_SECRET="drophub_webhook_secret_key_123456"

# 5. Automações n8n (Opcional - Operação não-bloqueante)
N8N_WEBHOOK_URL="http://localhost:5678/webhook/drophub-events"

# 6. Inteligência Artificial (OpenAI)
OPENAI_API_KEY="" # Deixe em branco para usar fallback estruturado ou insira sua chave sk-...
OPENAI_MODEL="gpt-4o-mini"

# 7. Gateway de Pagamento (Modo Teste / Mock no MVP)
PAYMENT_GATEWAY="TEST_MODE" # Opções futuras: TEST_MODE, MERCADO_PAGO, ASAAS
MERCADO_PAGO_ACCESS_TOKEN=""

# 8. Segredo de Autenticação dos Endpoints de Cron (/api/cron/*)
CRON_SECRET="drophub_super_secure_cron_secret_key_2026"
